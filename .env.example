# 阿里云百炼 API Key（粤语语音识别用）
# 获取：https://bailian.console.aliyun.com/ → API-KEY 管理
DASHSCOPE_API_KEY=

# 火山方舟豆包 API Key（翻译用，--provider doubao 时生效）
# 获取：https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=

# OpenAI API Key（翻译用，--provider openai 时生效）
OPENAI_API_KEY=

# 自定义 OpenAI 兼容翻译接口（--provider custom 时生效）
# 示例：本地 ollama（免费）→ CUSTOM_BASE_URL=http://localhost:11434/v1，CUSTOM_API_KEY 可留空
# 示例：硅基流动免费模型 → CUSTOM_BASE_URL=https://api.siliconflow.cn/v1
# CUSTOM_BASE_URL=
# CUSTOM_API_KEY=

# 可选：翻译模型 ID 覆盖（默认 doubao-pro-32k / gpt-4o-mini）
# ARK_MODEL_ID=
# OPENAI_MODEL_ID=
